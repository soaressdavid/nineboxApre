PORT=3000
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ninebox"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ninebox"
JWT_SECRET="your_jwt_secret_here"
JWT_EXPIRES_IN=15m
NODE_ENV=development

# CORS — lista separada por vírgula. Em produção: CORS_ORIGINS=https://app.empresa.com
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Refresh Token
REFRESH_TOKEN_EXPIRES_DAYS=7

# Logging
LOG_LEVEL=info
